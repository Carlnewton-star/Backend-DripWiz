NODE_ENV=development
PORT=5000
# Local Mongo for dev; production points at the shared Atlas cluster's
# dripwiz database (see docs/status.md).
MONGODB_URI=mongodb://127.0.0.1:27017/dripwiz
FRONTEND_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Cloudinary — used for product image storage/upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_FILE_UPLOAD=1000000

# Optional — forgot-password email. Without these, POST /auth/forgotpassword
# returns a clear 501 instead of attempting to send. Production uses
# SendGrid; local dev can use any SMTP host.
SENDGRID_USERNAME=
SENDGRID_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
